# Copy the frontend values to apps/web/.env.local for local development.
# `npm run convex:dev` creates these values after you select a development
# deployment. Do not commit the generated .env.local file.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Planned local-only integrations. These are not active in the dashboard yet.
ML_API_BASE_URL=http://127.0.0.1:8000
WEATHER_PROVIDER=open-meteo
